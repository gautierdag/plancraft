    {
      "id": "legend_bg",
      "type": "rectangle",
      "x": 710,
      "y": 100,
      "width": 270,
      "height": 250,
      "backgroundColor": "#ffffff",
      "strokeColor": "#868e96",
      "strokeStyle": "dashed"
    },
    {
      "id": "legend_title",
      "type": "text",
      "x": 725,
      "y": 110,
      "strokeColor": "#1e1e1e",
      "text": "Legend",
      "fontSize": 18,
      "fontFamily": 2
    },
    {
      "id": "legend_formal",
      "type": "text",
      "x": 725,
      "y": 140,
      "strokeColor": "#1e1e1e",
      "text": "A = {a_orch, a_1, ..., a_n}\nC = star via shared memory\n\u03a9 = hierarchical + re-planning\nn = 1\u20133 (dynamic)",
      "fontSize": 13,
      "fontFamily": 3
    },
    {
      "id": "legend_arrows",
      "type": "text",
      "x": 725,
      "y": 240,
      "strokeColor": "#868e96",
      "text": "\u2500\u2500 solid arrow = sync flow\n- - dashed = async / loop\n\u25cf  dot head = data write\n\u25b7  arrow head = control flow",
      "fontSize": 12,
      "fontFamily": 3
    },
    {
      "id": "legend_complexity",
      "type": "text",
      "x": 725,
      "y": 310,
      "strokeColor": "#868e96",
      "text": "Complexity per step:\nO(k_orch) + O(n\u00b7max_steps\u00b7k)\n+ O(k_synth)",
      "fontSize": 12,
      "fontFamily": 3
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  }
