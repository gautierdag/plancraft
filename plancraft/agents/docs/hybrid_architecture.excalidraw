{
  "type": "excalidraw",
  "version": 2,
  "source": "mcp-excalidraw-server",
  "elements": [
    {
      "id": "title",
      "type": "text",
      "x": 100,
      "y": 10,
      "strokeColor": "#1e1e1e",
      "text": "Hybrid MAS — Orchestrator-Worker Architecture",
      "fontSize": 28,
      "fontFamily": 2
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 80,
      "y": 50,
      "strokeColor": "#868e96",
      "text": "copilot_hybrid.py  |  Star topology via Shared Memory  |  Iterative Re-planning  |  Dynamic Worker Scaling",
      "fontSize": 14,
      "fontFamily": 2
    },
    {
      "id": "env",
      "type": "rectangle",
      "x": 270,
      "y": 100,
      "width": 280,
      "height": 55,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#868e96",
      "label": { "text": "Environment (Observation)" }
    },
    {
      "id": "phase1",
      "type": "rectangle",
      "x": 210,
      "y": 225,
      "width": 400,
      "height": 80,
